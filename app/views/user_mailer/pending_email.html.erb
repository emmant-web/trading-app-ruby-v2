<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your TradeNova Account is Pending Approval</title>
  <style>
    /* Mobile tweaks */
    @media only screen and (max-width: 600px) {
      .container { width: 100% !important; border-radius: 0 !important; }
      .header h1 { font-size: 22px !important; }
      .content h2 { font-size: 18px !important; }
      .button a { display: block !important; width: 100% !important; padding: 14px !important; font-size: 15px !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f3f4f6; font-family: Arial, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f3f4f6; padding:20px 0;">
    <tr>
      <td align="center">
        <table cellpadding="0" cellspacing="0" border="0" class="container" width="600" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:8px; overflow:hidden;">
          
          <!-- Header -->
          <tr>
            <td align="center" class="header" style="background-color:#0f172a; color:#ffffff; padding:40px 20px;">
              <div style="margin-bottom:16px;">
                <div style="display:inline-flex; align-items:center; justify-content:center; width:64px; height:64px; background-color:rgba(255,255,255,0.1); border-radius:50%; font-size:28px;">
                  ⏳
                </div>
              </div>
              <h1 style="margin:0; font-size:28px; font-weight:bold;">TradeNova</h1>
              <p style="margin:8px 0 0; font-size:16px; color:#cbd5e1;">Empowering your financial journey</p>
            </td>
          </tr>

          <!-- Main Content -->
          <tr>
            <td style="padding:40px 20px; text-align:center;" class="content">
              <h2 style="font-size:22px; color:#1f2937; margin:0 0 16px;">Account Pending Approval</h2>

              <div style="background-color:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:20px; margin-bottom:32px; text-align:left;">
                <p style="margin:0 0 8px; font-size:16px; color:#374151;">
                  Hello <strong style="color:#16a34a;"><%= @user.first_name %></strong>!
                </p>
                <p style="margin:0; font-size:14px; color:#4b5563;">
                  Thank you for signing up with <strong>TradeNova</strong>. Your account is currently <strong style="color:#e67e22;">pending admin approval</strong>.
                </p>
              </div>

              <div style="background-color:#f9fafb; border-radius:8px; padding:20px; margin-bottom:32px; text-align:left;">
                <p style="margin:0; font-size:14px; color:#4b5563;">
                  You’ll receive another email once your account has been approved and is ready to trade.  
                  We appreciate your patience as our team reviews your details.
                </p>
              </div>

              <!-- Button -->
              <div style="margin-bottom:32px;" class="button">
                <a href="<%= root_url %>" 
                   style="background-color:#16a34a; color:#ffffff; text-decoration:none; font-weight:bold; padding:16px 32px; border-radius:8px; font-size:16px; display:inline-block;">
                  Visit TradeNova
                </a>
              </div>

              <!-- Note -->
              <div style="background-color:#fefce8; border:1px solid #fef08a; border-radius:6px; padding:12px; text-align:left;">
                <p style="margin:0; font-size:13px; color:#92400e;">
                  If you didn’t create a TradeNova account, please ignore this email.
                </p>
              </div>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#f3f4f6; padding:24px; text-align:center;">
              <div style="display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:12px;">
                <div style="width:28px; height:28px; background:#0f172a; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:16px; color:#ffffff;">
                  📈
                </div>
                <span style="font-weight:600; color:#374151;">TradeNova</span>
              </div>
              <p style="margin:0; font-size:12px; color:#6b7280;">
                Access global markets, execute with precision, and grow your portfolio on a secure, intuitive platform.
              </p>
              <p style="margin:8px 0 0; font-size:11px; color:#9ca3af;">© <%= Time.now.year %> TradeNova. All rights reserved.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
