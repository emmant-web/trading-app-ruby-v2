<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Account Approved</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f5f7fa; font-family: Arial, sans-serif; color: #333;">
    <table width="100%" cellpadding="0" cellspacing="0" style="padding: 40px 0;">
      <tr>
        <td align="center">
          <table width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-radius: 8px; padding: 40px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
            <tr>
              <td align="center">
                <!-- Approval Check Icon -->
                <div style="width: 80px; height: 80px; background-color: #27ae60; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 25px;">
                  <span style="font-size: 40px; color: #fff;">&#10003;</span>
                </div>
                <h1 style="color: #27ae60; font-size: 24px; margin-bottom: 20px;">
                  Congratulations, <%= @user.first_name %>!
                </h1>
                <p style="font-size: 16px; line-height: 1.6; margin-bottom: 20px;">
                  Your <strong>TradeNova</strong> account has been <strong style="color: #27ae60;">approved</strong>.
                  You can now sign in and start trading with your account.
                </p>
                <p style="font-size: 16px; line-height: 1.6; margin-bottom: 30px;">
                  We're excited to have you onboard — let's make great trades together!
                </p>

                <!-- Sign In Button -->
                <a href="<%= new_user_session_path %>" style="display: inline-block; background-color: #27ae60; color: #fff; text-decoration: none; padding: 12px 28px; border-radius: 6px; font-weight: bold;">
                  Sign In to TradeNova
                </a>

                <hr style="margin: 40px 0; border: none; border-top: 1px solid #eaeaea;" />
                <p style="font-size: 12px; color: #888888; text-align: center;">
                  &copy; <%= Time.now.year %> TradeNova. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
